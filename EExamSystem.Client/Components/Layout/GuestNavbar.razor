@inject LanguageService Lang
@implements IDisposable
@rendermode InteractiveServer

<nav class="w-full bg-primary border-b border-brand-4 px-6 py-4 flex items-center justify-between">
    <a href="/" class="flex items-center gap-2">
        <img src="/KAU_logo.png" alt="KAU Logo" class="h-10 w-auto" />
    </a>

    <div class="flex items-center gap-4 text-sm font-medium">
        <a href="/login" class="text-white hover:text-primary-light transition-colors">
            @Lang.T("nav.login")
        </a>

        <div class="flex items-center gap-1 border border-brand-4 rounded-full p-0.5 text-xs">
            <button @onclick='() => Lang.SetLanguage("en")'
                    class="px-2.5 py-1 rounded-full transition-colors @(Lang.Current == "en" ? "bg-secondary text-white font-semibold" : "text-white hover:bg-secondary")">
                EN
            </button>
            <button @onclick='() => Lang.SetLanguage("ar")'
                    class="px-2.5 py-1 rounded-full transition-colors @(Lang.Current == "ar" ? "bg-secondary text-white font-semibold" : "text-white hover:bg-secondary")">
                AR
            </button>
        </div>
    </div>
</nav>

@code {
    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;
}
