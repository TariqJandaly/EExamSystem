@page "/"
@page "/login"
@layout GuestLayout
@inject NavigationManager Navigation
@inject LanguageService Lang
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>Login — EExam</PageTitle>

<div class="min-h-[90vh] flex items-center justify-center bg-background px-4">
    <div class="w-full max-w-md">

        <div class="text-center mb-8">
            <img src="/KAU_logo.png" alt="KAU Logo" class="h-[250px] w-auto mx-auto mb-4" />
            <h1 class="text-3xl font-bold text-primary">@Lang.T("login.welcome")</h1>
            <p class="text-sm text-secondary mt-1">@Lang.T("login.subtitle")</p>
        </div>

        <div class="bg-white rounded-2xl shadow-lg p-8 border border-brand-4">

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">
                    @errorMessage
                </div>
            }

            <div class="mb-5">
                <label class="block text-sm font-medium text-foreground mb-1">@Lang.T("login.email")</label>
                <input @bind="email" type="email" placeholder="@Lang.T("login.email.ph")"
                       class="w-full px-4 py-2.5 rounded-lg border border-brand-4 bg-brand-5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition" />
            </div>

            <div class="mb-6">
                <label class="block text-sm font-medium text-foreground mb-1">@Lang.T("login.password")</label>
                <input @bind="password" type="password" placeholder="••••••••"
                       class="w-full px-4 py-2.5 rounded-lg border border-brand-4 bg-brand-5 text-foreground placeholder:text-muted-foreground focus:outline-none focus:ring-2 focus:ring-primary focus:border-transparent transition" />
            </div>

            <button @onclick="HandleLogin" disabled="@isLoading"
                    class="w-full py-2.5 rounded-lg bg-primary text-primary-foreground font-semibold hover:bg-primary-light transition-colors disabled:opacity-60 disabled:cursor-not-allowed">
                @(isLoading ? Lang.T("login.loading") : Lang.T("login.submit"))
            </button>
        </div>

    </div>
</div>

@code {
    private string email = "";
    private string password = "";
    private string? errorMessage;
    private bool isLoading = false;

    private readonly Dictionary<string, string> mockAccounts = new()
    {
        { "student@eexam.com",    "/exams" },
        { "instructor@eexam.com", "/instructor" },
        { "admin@eexam.com",      "/admin" },
    };

    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;

    private async Task HandleLogin()
    {
        if (string.IsNullOrWhiteSpace(email) || string.IsNullOrWhiteSpace(password))
        {
            errorMessage = Lang.T("login.err.empty");
            return;
        }

        isLoading = true;
        errorMessage = null;
        await Task.Delay(300);

        if (mockAccounts.TryGetValue(email.Trim().ToLower(), out var redirect) && password == "password")
        {
            Navigation.NavigateTo(redirect);
            return;
        }

        isLoading = false;
        errorMessage = Lang.T("login.err.invalid");
    }
}
