@page "/exams/{Id}"

<PageTitle>Take Exam</PageTitle>

<div class="max-w-3xl mx-auto px-4 py-8">

    <div class="flex items-center justify-between mb-6">
        <div>
            <h1 class="text-2xl font-bold text-primary">Midterm Exam</h1>
            <p class="text-sm text-secondary">CS301 - Algorithms</p>
        </div>
        <div class="text-right">
            <div class="text-2xl font-mono font-bold @(timeLeft < 300 ? "text-red-500" : "text-primary")">
                @FormatTime(timeLeft)
            </div>
            <p class="text-xs text-secondary">remaining</p>
        </div>
    </div>

    <div class="w-full bg-brand-4 rounded-full h-1.5 mb-8">
        <div class="bg-primary h-1.5 rounded-full transition-all"
             style="width: @((currentQuestion + 1) * 100 / questions.Count)%"></div>
    </div>

    <div class="bg-white border border-brand-4 rounded-2xl p-8 shadow-sm mb-6">
        <p class="text-xs font-medium text-secondary mb-4">Question @(currentQuestion + 1) of @questions.Count</p>
        <h2 class="text-lg font-semibold text-foreground mb-6">@questions[currentQuestion].Text</h2>

        <div class="flex flex-col gap-3">
            @for (int i = 0; i < questions[currentQuestion].Options.Length; i++)
            {
                var idx = i;
                var option = questions[currentQuestion].Options[i];
                var isSelected = answers.ContainsKey(currentQuestion) && answers[currentQuestion] == idx;

                <button @onclick="() => SelectAnswer(idx)"
                        class="w-full text-left px-5 py-3.5 rounded-xl border-2 text-sm font-medium transition-all
                               @(isSelected ? "border-primary bg-brand-4 text-primary" : "border-brand-4 bg-brand-5 text-foreground hover:border-primary-light")">
                    <span class="font-bold mr-3">@((char)('A' + idx)).</span> @option
                </button>
            }
        </div>
    </div>

    <div class="flex items-center justify-between">
        <button @onclick="PrevQuestion" disabled="@(currentQuestion == 0)"
                class="px-5 py-2 rounded-lg border border-brand-4 text-sm font-medium text-foreground hover:bg-brand-4 transition-colors disabled:opacity-40 disabled:cursor-not-allowed">
            Previous
        </button>

        <div class="flex gap-1.5">
            @for (int i = 0; i < questions.Count; i++)
            {
                var idx = i;
                <button @onclick="() => currentQuestion = idx"
                        class="w-8 h-8 rounded-full text-xs font-medium transition-colors
                               @(i == currentQuestion ? "bg-primary text-white" : answers.ContainsKey(i) ? "bg-brand-3 text-white" : "bg-brand-4 text-foreground")">
                    @(i + 1)
                </button>
            }
        </div>

        @if (currentQuestion < questions.Count - 1)
        {
            <button @onclick="NextQuestion"
                    class="px-5 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                Next
            </button>
        }
        else
        {
            <button @onclick="SubmitExam"
                    class="px-5 py-2 rounded-lg bg-brand-s1 text-white text-sm font-semibold hover:bg-secondary-light transition-colors">
                Submit
            </button>
        }
    </div>
</div>

@code {
    [Parameter] public string Id { get; set; } = "";

    private int currentQuestion = 0;
    private int timeLeft = 5400; // 90 min in seconds
    private Dictionary<int, int> answers = new();

    private record Question(string Text, string[] Options);

    private List<Question> questions = new()
    {
        new("What is the time complexity of binary search?",
            new[] { "O(n)", "O(log n)", "O(n log n)", "O(1)" }),
        new("Which data structure uses LIFO order?",
            new[] { "Queue", "Stack", "Linked List", "Tree" }),
        new("What does Big O notation measure?",
            new[] { "Memory usage only", "Time only", "Upper bound of complexity", "Exact runtime" }),
        new("Which sorting algorithm has O(n log n) worst case?",
            new[] { "Bubble Sort", "Quick Sort", "Merge Sort", "Insertion Sort" }),
        new("A complete binary tree with n nodes has height of:",
            new[] { "O(n)", "O(log n)", "O(n²)", "O(1)" }),
    };

    private void SelectAnswer(int optionIdx) => answers[currentQuestion] = optionIdx;
    private void NextQuestion() { if (currentQuestion < questions.Count - 1) currentQuestion++; }
    private void PrevQuestion() { if (currentQuestion > 0) currentQuestion--; }
    private void SubmitExam() { /* TODO: submit answers */ }

    private string FormatTime(int seconds)
    {
        var ts = TimeSpan.FromSeconds(seconds);
        return $"{ts.Hours:D2}:{ts.Minutes:D2}:{ts.Seconds:D2}";
    }
}
