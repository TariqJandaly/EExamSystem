@page "/admin/users"
@attribute [Authorize(Roles = "ADMIN,CHAIR")]
@inject LanguageService Lang
@inject ApiClient Api
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@Lang.T("admin.users.title")</PageTitle>

<div class="max-w-5xl mx-auto px-4 py-8">

    <div class="flex items-center gap-2 text-sm text-secondary mb-6">
        <a href="/admin" class="hover:text-primary transition-colors">@Lang.T("admin.title")</a>
        <span>/</span>
        <span class="text-foreground font-medium">@Lang.T("admin.users.title")</span>
    </div>

    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-primary">@Lang.T("admin.users.title")</h1>
            <p class="text-secondary mt-1">@Lang.T("admin.users.subtitle")</p>
        </div>
        <button @onclick="() => { showCreateForm = !showCreateForm; errorMessage = null; successMessage = null; }"
                class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
            @Lang.T("admin.users.create")
        </button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }
    @if (successMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@successMessage</div>
    }

    @if (showCreateForm)
    {
        <div class="bg-white border border-primary rounded-2xl p-6 shadow-sm mb-6">
            <h3 class="font-semibold text-foreground mb-4">@Lang.T("users.form.create")</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.users.fullname")</label>
                    <input @bind="newUser.FullName" placeholder="@Lang.T("users.fullname.ph")"
                           class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.users.email")</label>
                    <input @bind="newUser.Email" type="email" placeholder="@Lang.T("users.email.ph")"
                           class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.users.password")</label>
                    <input @bind="newUser.Password" type="password" placeholder="@Lang.T("users.password.ph")"
                           class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.users.roles")</label>
                    <div class="flex gap-3 flex-wrap mt-1">
                        @foreach (var role in allRoles)
                        {
                            var r = role;
                            <label class="flex items-center gap-1.5 text-sm cursor-pointer">
                                <input type="checkbox"
                                       checked="@newUser.Roles.Contains(r)"
                                       @onchange="e => ToggleNewUserRole(r, (bool)e.Value!)"
                                       class="rounded" />
                                @r
                            </label>
                        }
                    </div>
                </div>
            </div>
            <div class="flex gap-3">
                <button @onclick="CreateUser"
                        class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                    @Lang.T("action.create")
                </button>
                <button @onclick="() => showCreateForm = false"
                        class="px-4 py-2 rounded-lg border border-brand-4 text-sm text-secondary hover:bg-brand-5 transition-colors">
                    @Lang.T("action.cancel")
                </button>
            </div>
        </div>
    }

    <!-- Search -->
    <div class="mb-4">
        <input @bind="searchQuery" @bind:event="oninput" placeholder="Search by name or email..."
               class="w-full md:w-80 px-4 py-2 rounded-lg border border-brand-4 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
    </div>

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">@Lang.T("common.loading.users")</p>
    }
    else if (FilteredUsers.Count == 0)
    {
        <div class="text-center py-16 text-secondary border border-dashed border-brand-4 rounded-2xl">
            <p class="font-medium">@Lang.T("admin.users.empty")</p>
        </div>
    }
    else
    {
        <div class="bg-white border border-brand-4 rounded-2xl shadow-sm overflow-hidden">
            @foreach (var user in FilteredUsers)
            {
                <div class="flex items-center justify-between px-6 py-4 border-b border-brand-5 last:border-0 gap-4">
                    <div class="flex items-center gap-3 min-w-0">
                        <div class="w-9 h-9 rounded-full bg-brand-4 flex items-center justify-center text-primary font-bold text-sm shrink-0">
                            @(user.FullName.Length > 0 ? user.FullName[0] : '?')
                        </div>
                        <div class="min-w-0">
                            <p class="text-sm font-medium text-foreground truncate">@user.FullName</p>
                            <p class="text-xs text-secondary truncate">@user.Email</p>
                        </div>
                    </div>

                    <!-- Roles -->
                    <div class="flex gap-1 flex-wrap justify-center">
                        @foreach (var role in user.Roles)
                        {
                            <span class="text-xs px-2 py-0.5 rounded-full @RoleBadge(role) flex items-center gap-1">
                                @role
                                <button @onclick="() => RemoveRole(user.Id, role)"
                                        class="opacity-60 hover:opacity-100 leading-none" title="Remove role">✕</button>
                            </span>
                        }
                        <!-- Add role -->
                        @if (addingRoleUserId == user.Id)
                        {
                            <select @bind="addRoleValue" class="text-xs px-2 py-0.5 rounded-lg border border-brand-4 bg-brand-5 focus:outline-none">
                                <option value="">@Lang.T("users.select.role")</option>
                                @foreach (var r in allRoles.Where(r => !user.Roles.Contains(r)))
                                {
                                    <option value="@r">@r</option>
                                }
                            </select>
                            <button @onclick="() => AddRole(user.Id)"
                                    class="text-xs px-2 py-0.5 rounded-full bg-primary text-white">@Lang.T("users.add.role")</button>
                            <button @onclick="() => addingRoleUserId = null"
                                    class="text-xs text-secondary hover:text-foreground">✕</button>
                        }
                        else
                        {
                            <button @onclick="() => StartAddRole(user.Id)"
                                    class="text-xs px-2 py-0.5 rounded-full border border-dashed border-brand-4 text-secondary hover:text-primary hover:border-primary transition-colors">
                                + Role
                            </button>
                        }
                    </div>

                    <!-- Delete -->
                    @if (deletingUserId == user.Id)
                    {
                        <span class="text-xs text-red-600 flex items-center gap-1 shrink-0">
                            @Lang.T("action.confirm")
                            <button @onclick="() => ConfirmDeleteUser(user.Id)" class="underline ml-1">@Lang.T("action.yes")</button>
                            <button @onclick="() => deletingUserId = null" class="underline ml-1">@Lang.T("action.no")</button>
                        </span>
                    }
                    else
                    {
                        <button @onclick="() => deletingUserId = user.Id"
                                class="text-xs text-red-400 hover:text-red-600 transition-colors shrink-0">
                            @Lang.T("action.delete")
                        </button>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<UserDto> users = new();
    private bool isLoaded = false;
    private string? errorMessage;
    private string? successMessage;

    private bool showCreateForm = false;
    private string searchQuery = "";
    private string? deletingUserId;
    private string? addingRoleUserId;
    private string addRoleValue = "";

    private readonly string[] allRoles = { "STUDENT", "INSTRUCTOR", "ADMIN", "CHAIR" };

    private class NewUserForm
    {
        public string FullName { get; set; } = "";
        public string Email { get; set; } = "";
        public string Password { get; set; } = "";
        public List<string> Roles { get; set; } = new();
    }
    private NewUserForm newUser = new();

    private List<UserDto> FilteredUsers => string.IsNullOrWhiteSpace(searchQuery)
        ? users
        : users.Where(u =>
            u.FullName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            u.Email.Contains(searchQuery, StringComparison.OrdinalIgnoreCase) ||
            u.Roles.Any(r => r.Contains(searchQuery, StringComparison.OrdinalIgnoreCase)))
          .ToList();

    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadUsers();
    }

    private async Task LoadUsers()
    {
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<List<UserDto>>>("/api/v1/user");
            users = res?.Data ?? new();
        }
        catch (Exception ex) { errorMessage = $"Failed to load users: {ex.Message}"; }
        finally { isLoaded = true; StateHasChanged(); }
    }

    private void StartAddRole(string userId) { addingRoleUserId = userId; addRoleValue = ""; }

    private void ToggleNewUserRole(string role, bool add)
    {
        if (add) { if (!newUser.Roles.Contains(role)) newUser.Roles.Add(role); }
        else newUser.Roles.Remove(role);
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newUser.FullName) || string.IsNullOrWhiteSpace(newUser.Email) ||
            string.IsNullOrWhiteSpace(newUser.Password))
        {
            errorMessage = Lang.T("users.err.required");
            return;
        }
        if (newUser.Password.Length < 8)
        {
            errorMessage = Lang.T("users.err.password");
            return;
        }
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var dto = new UserCreateDto
            {
                FullName = newUser.FullName,
                Email = newUser.Email,
                Password = newUser.Password,
                Roles = newUser.Roles
            };
            var res = await http.PostAsJsonAsync("/api/v1/user", dto);
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<UserDto>>();
            if (result?.Success == true)
            {
                newUser = new();
                showCreateForm = false;
                successMessage = "User created successfully.";
                await LoadUsers();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task AddRole(string userId)
    {
        if (string.IsNullOrEmpty(addRoleValue)) return;
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PostAsJsonAsync($"/api/v1/user/{userId}/roles",
                new UserRolesDto { UserId = userId, Roles = new List<string> { addRoleValue } });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<UserDto>>();
            if (result?.Success == true)
            {
                addingRoleUserId = null;
                successMessage = $"Role {addRoleValue} added.";
                await LoadUsers();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task RemoveRole(string userId, string role)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.SendAsync(new HttpRequestMessage(HttpMethod.Delete, $"/api/v1/user/{userId}/roles")
            {
                Content = JsonContent.Create(new UserRolesDto { UserId = userId, Roles = new List<string> { role } })
            });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<UserDto>>();
            if (result?.Success == true)
            {
                successMessage = $"Role {role} removed.";
                await LoadUsers();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task ConfirmDeleteUser(string userId)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.DeleteAsync($"/api/v1/user/{userId}");
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<UserDto>>();
            if (result?.Success == true)
            {
                deletingUserId = null;
                successMessage = "User deleted.";
                await LoadUsers();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { deletingUserId = null; StateHasChanged(); }
    }

    private static string RoleBadge(string role) => role switch
    {
        "ADMIN" or "CHAIR" => "bg-brand-s1 text-white",
        "INSTRUCTOR"       => "bg-secondary text-white",
        "STUDENT"          => "bg-brand-4 text-foreground",
        _                  => "bg-brand-5 text-secondary"
    };
}
