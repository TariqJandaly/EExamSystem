@page "/admin/courses"
@attribute [Authorize(Roles = "ADMIN,CHAIR")]
@inject LanguageService Lang
@inject ApiClient Api
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@Lang.T("admin.courses.title")</PageTitle>

<div class="max-w-4xl mx-auto px-4 py-8">

    <div class="flex items-center gap-2 text-sm text-secondary mb-6">
        <a href="/admin" class="hover:text-primary transition-colors">@Lang.T("admin.title")</a>
        <span>/</span>
        <span class="text-foreground font-medium">@Lang.T("admin.courses.title")</span>
    </div>

    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-primary">@Lang.T("admin.courses.title")</h1>
            <p class="text-secondary mt-1">@Lang.T("admin.courses.subtitle")</p>
        </div>
        <button @onclick="() => { showCreateForm = !showCreateForm; errorMessage = null; successMessage = null; }"
                class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
            @Lang.T("admin.courses.create")
        </button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }
    @if (successMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@successMessage</div>
    }

    @if (showCreateForm)
    {
        <div class="bg-white border border-primary rounded-2xl p-6 shadow-sm mb-6">
            <h3 class="font-semibold text-foreground mb-4">New Course</h3>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-4">
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.courses.name")</label>
                    <input @bind="newName" placeholder="e.g. Data Structures"
                           class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>
                <div>
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("admin.courses.code")</label>
                    <input @bind="newCode" placeholder="@Lang.T("admin.courses.code.ph")"
                           class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                    <p class="text-xs text-secondary mt-1">Letters followed by numbers, e.g. CPCS202</p>
                </div>
            </div>
            <div class="flex gap-3">
                <button @onclick="CreateCourse"
                        class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                    @Lang.T("action.create")
                </button>
                <button @onclick="() => showCreateForm = false"
                        class="px-4 py-2 rounded-lg border border-brand-4 text-sm text-secondary hover:bg-brand-5 transition-colors">
                    @Lang.T("action.cancel")
                </button>
            </div>
        </div>
    }

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">Loading courses...</p>
    }
    else if (courses.Count == 0)
    {
        <div class="text-center py-16 text-secondary border border-dashed border-brand-4 rounded-2xl">
            <p class="font-medium">@Lang.T("admin.courses.empty")</p>
        </div>
    }
    else
    {
        <div class="bg-white border border-brand-4 rounded-2xl shadow-sm overflow-hidden">
            @foreach (var course in courses)
            {
                <div class="flex items-center justify-between px-6 py-4 border-b border-brand-5 last:border-0 gap-4">
                    @if (editingCourseId == course.Id)
                    {
                        <div class="flex items-center gap-3 flex-1">
                            <input @bind="editName" placeholder="Course name"
                                   class="flex-1 px-3 py-1.5 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                            <input @bind="editCode" placeholder="Code"
                                   class="w-28 px-3 py-1.5 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                            <button @onclick="() => SaveCourse(course.Id)"
                                    class="text-xs px-3 py-1.5 rounded-lg bg-primary text-white hover:bg-primary-light transition-colors">
                                @Lang.T("action.save")
                            </button>
                            <button @onclick="CancelEdit"
                                    class="text-xs px-3 py-1.5 rounded-lg border border-brand-4 text-secondary hover:bg-brand-5 transition-colors">
                                @Lang.T("action.cancel")
                            </button>
                        </div>
                    }
                    else
                    {
                        <div class="min-w-0 flex-1">
                            <p class="text-sm font-semibold text-foreground">@course.Name</p>
                            <p class="text-xs text-secondary mt-0.5">@course.Code</p>
                        </div>
                        <div class="flex items-center gap-2 shrink-0">
                            <button @onclick="() => StartEdit(course)"
                                    class="text-xs text-secondary hover:text-primary transition-colors px-2 py-1 rounded hover:bg-brand-5">
                                @Lang.T("action.edit")
                            </button>
                            @if (deletingCourseId == course.Id)
                            {
                                <span class="text-xs text-red-600 flex items-center gap-1">
                                    @Lang.T("action.confirm")
                                    <button @onclick="() => ConfirmDeleteCourse(course.Id)" class="underline ml-1">@Lang.T("action.yes")</button>
                                    <button @onclick="() => deletingCourseId = null" class="underline ml-1">@Lang.T("action.no")</button>
                                </span>
                            }
                            else
                            {
                                <button @onclick="() => deletingCourseId = course.Id"
                                        class="text-xs text-red-400 hover:text-red-600 transition-colors px-2 py-1 rounded hover:bg-red-50">
                                    @Lang.T("action.delete")
                                </button>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    private List<CourseDto> courses = new();
    private bool isLoaded = false;
    private string? errorMessage;
    private string? successMessage;

    private bool showCreateForm = false;
    private string newName = "";
    private string newCode = "";

    private int? editingCourseId;
    private string editName = "";
    private string editCode = "";
    private int? deletingCourseId;

    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadCourses();
    }

    private async Task LoadCourses()
    {
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<CourseDto>>>("/api/v1/courses");
            courses = res?.Data?.ToList() ?? new();
        }
        catch (Exception ex) { errorMessage = $"Failed to load courses: {ex.Message}"; }
        finally { isLoaded = true; StateHasChanged(); }
    }

    private async Task CreateCourse()
    {
        if (string.IsNullOrWhiteSpace(newName) || string.IsNullOrWhiteSpace(newCode))
        {
            errorMessage = "Please provide both name and code.";
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(newCode, @"^[A-Za-z]+\d+$"))
        {
            errorMessage = "Code must be letters followed by numbers (e.g. CPCS202).";
            return;
        }
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PostAsJsonAsync("/api/v1/courses",
                new CreateCourseDto { Name = newName, Code = newCode });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<CourseDto>>();
            if (result?.Success == true)
            {
                newName = ""; newCode = "";
                showCreateForm = false;
                successMessage = "Course created.";
                await LoadCourses();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private void StartEdit(CourseDto course)
    {
        editingCourseId = course.Id;
        editName = course.Name;
        editCode = course.Code;
    }

    private void CancelEdit()
    {
        editingCourseId = null;
        editName = ""; editCode = "";
    }

    private async Task SaveCourse(int courseId)
    {
        if (string.IsNullOrWhiteSpace(editName) || string.IsNullOrWhiteSpace(editCode))
        {
            errorMessage = "Name and code are required.";
            return;
        }
        if (!System.Text.RegularExpressions.Regex.IsMatch(editCode, @"^[A-Za-z]+\d+$"))
        {
            errorMessage = "Code must be letters followed by numbers (e.g. CPCS202).";
            return;
        }
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PutAsJsonAsync($"/api/v1/courses/{courseId}",
                new CreateCourseDto { Name = editName, Code = editCode });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                editingCourseId = null;
                successMessage = "Course updated.";
                await LoadCourses();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task ConfirmDeleteCourse(int courseId)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.DeleteAsync($"/api/v1/courses/{courseId}");
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                successMessage = "Course deleted.";
                await LoadCourses();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { deletingCourseId = null; StateHasChanged(); }
    }
}
