@page "/admin"
@attribute [Authorize(Roles = "ADMIN,CHAIR")]
@inject LanguageService Lang
@inject ApiClient Api
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@Lang.T("admin.title")</PageTitle>

<div class="max-w-6xl mx-auto px-4 py-8">

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-primary">@Lang.T("admin.title")</h1>
        <p class="text-secondary mt-1">@Lang.T("admin.subtitle")</p>
    </div>

    <!-- Quick actions -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-8">
        <a href="/admin/users"
           class="flex items-center gap-4 bg-white border border-brand-4 rounded-2xl p-5 shadow-sm hover:shadow-md hover:border-primary-light transition-all group">
            <div class="w-10 h-10 rounded-xl bg-brand-4 flex items-center justify-center text-primary font-bold text-lg group-hover:bg-primary group-hover:text-white transition-colors">M</div>
            <div>
                <p class="font-semibold text-foreground group-hover:text-primary transition-colors">@Lang.T("admin.users.title")</p>
                <p class="text-xs text-secondary">Create, manage and assign roles</p>
            </div>
        </a>
        <a href="/admin/courses"
           class="flex items-center gap-4 bg-white border border-brand-4 rounded-2xl p-5 shadow-sm hover:shadow-md hover:border-primary-light transition-all group">
            <div class="w-10 h-10 rounded-xl bg-brand-4 flex items-center justify-center text-primary font-bold text-lg group-hover:bg-primary group-hover:text-white transition-colors">M</div>
            <div>
                <p class="font-semibold text-foreground group-hover:text-primary transition-colors">@Lang.T("admin.courses.title")</p>
                <p class="text-xs text-secondary">Add, edit and remove courses</p>
            </div>
        </a>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">Loading dashboard...</p>
    }
    else
    {
        <div class="grid grid-cols-2 md:grid-cols-4 gap-4 mb-10">
            @foreach (var stat in stats)
            {
                <div class="bg-white border border-brand-4 rounded-2xl p-5 shadow-sm">
                    <p class="text-xs font-medium text-secondary uppercase tracking-wide mb-1">@stat.Label</p>
                    <p class="text-3xl font-bold text-primary">@stat.Value</p>
                    <p class="text-xs text-secondary mt-1">@stat.Sub</p>
                </div>
            }
        </div>

        <div class="bg-white border border-brand-4 rounded-2xl p-6 shadow-sm">
            <h2 class="font-semibold text-foreground mb-4">All Users</h2>
            <div class="flex flex-col gap-3">
                @foreach (var user in users)
                {
                    <div class="flex items-center justify-between py-2 border-b border-brand-5 last:border-0">
                        <div class="flex items-center gap-3">
                            <div class="w-8 h-8 rounded-full bg-brand-4 flex items-center justify-center text-primary font-bold text-sm">
                                @(user.FullName.Length > 0 ? user.FullName[0] : '?')
                            </div>
                            <div>
                                <p class="text-sm font-medium text-foreground">@user.FullName</p>
                                <p class="text-xs text-secondary">@user.Email</p>
                            </div>
                        </div>
                        <div class="flex gap-1 flex-wrap justify-end">
                            @foreach (var role in user.Roles)
                            {
                                <span class="text-xs px-2 py-0.5 rounded-full @RoleBadge(role)">@role</span>
                            }
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private record Stat(string Label, string Value, string Sub);

    private List<Stat> stats = new();
    private List<UserDto> users = new();
    private bool isLoaded = false;
    private string? errorMessage;

    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var http = await Api.CreateAsync();

            var userRes = await http.GetFromJsonAsync<ServiceResponse<List<UserDto>>>(
                "/api/v1/user");
            users = userRes?.Data ?? new();

            var courseRes = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<CourseDto>>>(
                "/api/v1/courses");
            var courseCount = courseRes?.Data?.Count() ?? 0;

            stats = new()
            {
                new("Total Users",   users.Count.ToString(),                                      "registered"),
                new("Instructors",   users.Count(u => u.Roles.Contains("INSTRUCTOR")).ToString(), "active"),
                new("Students",      users.Count(u => u.Roles.Contains("STUDENT")).ToString(),    "active"),
                new("Courses",       courseCount.ToString(),                                      "this semester"),
            };
        }
        catch { }
        finally
        {
            isLoaded = true;
            StateHasChanged();
        }
    }

    private static string RoleBadge(string role) => role switch
    {
        "ADMIN"      => "bg-brand-s1 text-white",
        "CHAIR"      => "bg-brand-s1 text-white",
        "INSTRUCTOR" => "bg-secondary text-white",
        "STUDENT"    => "bg-brand-4 text-foreground",
        _            => "bg-brand-5 text-secondary"
    };
}
