@page "/instructor/{CourseId:int}/banks/{BankId:int}"
@attribute [Authorize(Roles = "INSTRUCTOR,CHAIR,ADMIN")]
@inject ApiClient Api
@inject LanguageService Lang
@rendermode InteractiveServer

<PageTitle>@(bankName ?? "Bank Editor")</PageTitle>

<div class="max-w-4xl mx-auto px-4 py-8">

    <div class="flex items-center gap-2 text-sm text-secondary mb-6">
        <a href="/instructor" class="hover:text-primary transition-colors">@Lang.T("instructor.title")</a>
        <span>/</span>
        <a href="/instructor/@CourseId/banks" class="hover:text-primary transition-colors">@Lang.T("banks.title")</a>
        <span>/</span>
        <span class="text-foreground font-medium">@(bankName ?? $"Bank {BankId}")</span>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }
    @if (successMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@successMessage</div>
    }

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">@Lang.T("common.loading")</p>
    }
    else
    {
        <div class="flex items-start justify-between mb-6">
            <div>
                <h1 class="text-3xl font-bold text-primary">@(bankName ?? $"Bank {BankId}")</h1>
                <p class="text-secondary mt-1">@questions.Count question@(questions.Count != 1 ? "s" : "")</p>
            </div>
            @if (selectedChapter is not null)
            {
                <button @onclick="() => { showQuestionForm = true; ResetQuestionForm(); errorMessage = null; successMessage = null; }"
                        class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                    @Lang.T("editor.add.question")
                </button>
            }
        </div>

        <!-- Chapter tabs -->
        <div class="flex items-center gap-2 mb-6 flex-wrap">
            @foreach (var ch in chapters)
            {
                <div class="flex items-center gap-1">
                    @if (editingChapterId == ch.Id)
                    {
                        <input @bind="editChapterName"
                               class="px-2 py-1 rounded-lg border border-primary text-sm focus:outline-none w-36" />
                        <button @onclick="() => SaveChapterRename(ch.Id)"
                                class="text-xs text-primary hover:underline">@Lang.T("action.save")</button>
                        <button @onclick="CancelChapterEdit"
                                class="text-xs text-secondary hover:underline">@Lang.T("action.cancel")</button>
                    }
                    else
                    {
                        <button @onclick="() => SelectChapter(ch)"
                                class="px-3 py-1.5 rounded-full text-sm font-medium border transition-colors
                                       @(selectedChapter?.Id == ch.Id ? "bg-primary text-white border-primary" : "border-brand-4 text-secondary hover:border-primary-light")">
                            @ch.Name
                        </button>
                        @if (selectedChapter?.Id == ch.Id)
                        {
                            <button @onclick="() => StartChapterEdit(ch)"
                                    class="text-xs text-secondary hover:text-primary px-1" title="@Lang.T("editor.rename")">✎</button>
                            @if (deletingChapterId == ch.Id)
                            {
                                <span class="text-xs text-red-600 flex gap-1">
                                    @Lang.T("action.confirm")
                                    <button @onclick="() => ConfirmDeleteChapter(ch.Id)" class="underline">@Lang.T("action.yes")</button>
                                    <button @onclick="() => deletingChapterId = null" class="underline">@Lang.T("action.no")</button>
                                </span>
                            }
                            else
                            {
                                <button @onclick="() => deletingChapterId = ch.Id"
                                        class="text-xs text-red-400 hover:text-red-600 px-1" title="@Lang.T("editor.delete.chapter.title")">✕</button>
                            }
                        }
                    }
                </div>
            }

            @if (showNewChapterInput)
            {
                <input @bind="newChapterName" placeholder="@Lang.T("editor.chapter.ph")"
                       class="px-3 py-1.5 rounded-lg border border-brand-4 bg-brand-5 text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                <button @onclick="AddChapter" class="text-sm text-primary hover:underline">@Lang.T("action.save")</button>
                <button @onclick="() => showNewChapterInput = false" class="text-sm text-secondary hover:underline">@Lang.T("action.cancel")</button>
            }
            else
            {
                <button @onclick="() => showNewChapterInput = true"
                        class="text-xs px-3 py-1.5 rounded-full border border-dashed border-brand-4 text-secondary hover:text-primary hover:border-primary transition-colors">
                    @Lang.T("editor.add.chapter")
                </button>
            }
        </div>

        @if (selectedChapter is null && chapters.Count > 0)
        {
            <p class="text-secondary text-sm mb-6">@Lang.T("editor.select.chapter")</p>
        }
        else if (chapters.Count == 0)
        {
            <div class="text-center py-12 text-secondary border border-dashed border-brand-4 rounded-2xl">
                <p class="font-medium">@Lang.T("editor.no.chapters")</p>
                <p class="text-sm mt-1">@Lang.T("editor.no.chapters.hint")</p>
            </div>
        }

        <!-- Add/Edit Question form -->
        @if (showQuestionForm && selectedChapter is not null)
        {
            <div class="bg-white border border-primary rounded-2xl p-6 shadow-sm mb-6">
                <h3 class="font-semibold text-foreground mb-4">
                    @(editingQuestionId.HasValue ? Lang.T("editor.edit.question") : Lang.T("editor.new.question")) — @selectedChapter.Name
                </h3>

                <div class="mb-4">
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("editor.question.text")</label>
                    <textarea @bind="qForm.Content" rows="2" placeholder="@Lang.T("editor.question.text.ph")"
                              class="w-full px-4 py-2 rounded-lg border border-brand-4 bg-brand-5 text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-sm resize-none" />
                </div>

                <div class="mb-3">
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("editor.points")</label>
                    <input type="number" @bind="qForm.Points" min="1" max="100"
                           class="w-24 px-3 py-1.5 rounded-lg border border-brand-4 bg-brand-5 text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                </div>

                <div class="grid grid-cols-2 gap-3 mb-4">
                    @for (int i = 0; i < 4; i++)
                    {
                        var idx = i;
                        <div>
                            <label class="block text-xs font-medium text-secondary mb-1">Option @((char)('A' + idx))</label>
                            <input @bind="qForm.OptionTexts[idx]" placeholder="Option @((char)('A' + idx))"
                                   class="w-full px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-sm" />
                        </div>
                    }
                </div>

                <div class="mb-5">
                    <label class="block text-xs font-medium text-secondary mb-1">@Lang.T("editor.correct.answer")</label>
                    <select @bind="qForm.CorrectIndex"
                            class="px-3 py-2 rounded-lg border border-brand-4 bg-brand-5 text-foreground focus:outline-none focus:ring-2 focus:ring-primary text-sm">
                        <option value="0">A</option>
                        <option value="1">B</option>
                        <option value="2">C</option>
                        <option value="3">D</option>
                    </select>
                </div>

                <div class="flex gap-3">
                    <button @onclick="SaveQuestion"
                            class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                        @Lang.T("action.save")
                    </button>
                    <button @onclick="() => { showQuestionForm = false; editingQuestionId = null; }"
                            class="px-4 py-2 rounded-lg border border-brand-4 text-sm text-secondary hover:bg-brand-5 transition-colors">
                        @Lang.T("action.cancel")
                    </button>
                </div>
            </div>
        }

        <!-- Questions list -->
        @if (selectedChapter is not null)
        {
            @if (questions.Count == 0)
            {
                <div class="text-center py-12 text-secondary border border-dashed border-brand-4 rounded-2xl">
                    <p class="font-medium">@Lang.T("editor.no.questions")</p>
                    <p class="text-sm mt-1">@Lang.T("editor.no.questions.hint")</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @for (int i = 0; i < questions.Count; i++)
                    {
                        var q = questions[i];
                        var num = i + 1;
                        <div class="bg-white border border-brand-4 rounded-2xl p-6 shadow-sm">
                            <div class="flex items-start justify-between mb-3">
                                <p class="font-medium text-foreground flex-1">
                                    <span class="text-secondary font-normal mr-2">Q@(num).</span>@q.Content
                                    <span class="text-xs text-secondary ml-2">(@q.Points pt@(q.Points != 1 ? "s" : ""))</span>
                                </p>
                                <div class="flex items-center gap-2 ml-4 shrink-0">
                                    <button @onclick="() => StartEditQuestion(q)"
                                            class="text-xs text-secondary hover:text-primary transition-colors px-2 py-1 rounded hover:bg-brand-5">
                                        @Lang.T("action.edit")
                                    </button>
                                    @if (deletingQuestionId == q.Id)
                                    {
                                        <span class="text-xs text-red-600 flex gap-1">
                                            Sure?
                                            <button @onclick="() => ConfirmDeleteQuestion(q.Id)" class="underline">Yes</button>
                                            <button @onclick="() => deletingQuestionId = null" class="underline">No</button>
                                        </span>
                                    }
                                    else
                                    {
                                        <button @onclick="() => deletingQuestionId = q.Id"
                                                class="text-xs text-red-400 hover:text-red-600 transition-colors px-2 py-1 rounded hover:bg-red-50">
                                            @Lang.T("action.delete")
                                        </button>
                                    }
                                </div>
                            </div>
                            <div class="grid grid-cols-2 gap-2">
                                @foreach (var opt in q.Options)
                                {
                                    <div class="flex items-center gap-2 px-3 py-1.5 rounded-lg @(opt.IsCorrect ? "bg-brand-4 text-primary font-medium" : "bg-brand-5 text-secondary") text-sm">
                                        @opt.Text
                                        @if (opt.IsCorrect) { <span class="ml-auto text-xs">✓</span> }
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        }
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }
    [Parameter] public int BankId { get; set; }

    private string? bankName;
    private List<ChapterDto> chapters = new();
    private ChapterDto? selectedChapter;
    private List<QuestionDto> questions = new();

    private bool isLoaded = false;
    private string? errorMessage;
    private string? successMessage;

    // Chapter state
    private bool showNewChapterInput = false;
    private string newChapterName = "";
    private int? editingChapterId;
    private string editChapterName = "";
    private int? deletingChapterId;

    // Question form state
    private bool showQuestionForm = false;
    private int? editingQuestionId;
    private int? deletingQuestionId;

    private class QuestionForm
    {
        public string Content { get; set; } = "";
        public int Points { get; set; } = 1;
        public string[] OptionTexts { get; set; } = new string[4];
        public int CorrectIndex { get; set; } = 0;
    }
    private QuestionForm qForm = new() { OptionTexts = new string[4] };

    private void ResetQuestionForm() => qForm = new() { OptionTexts = new string[4] };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var http = await Api.CreateAsync();
            var bankRes = await http.GetFromJsonAsync<ServiceResponse<TestbankDto>>(
                $"/api/v1/testbank/{BankId}");
            bankName = bankRes?.Data?.Name;

            var chapterRes = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<ChapterDto>>>(
                $"/api/v1/testbanks/{BankId}/chapters");
            chapters = chapterRes?.Data?.ToList() ?? new();

            if (chapters.Count > 0)
                await SelectChapter(chapters[0]);
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load: {ex.Message}";
        }
        finally
        {
            isLoaded = true;
            StateHasChanged();
        }
    }

    private async Task SelectChapter(ChapterDto chapter)
    {
        selectedChapter = chapter;
        editingQuestionId = null;
        showQuestionForm = false;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<QuestionDto>>>(
                $"/api/v1/chapters/{chapter.Id}/questions");
            questions = res?.Data?.ToList() ?? new();
        }
        catch { questions = new(); }
        StateHasChanged();
    }

    private async Task AddChapter()
    {
        if (string.IsNullOrWhiteSpace(newChapterName)) return;
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PostAsJsonAsync($"/api/v1/testbanks/{BankId}/chapters",
                new ChapterCreateDto { Name = newChapterName });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<ChapterDto>>();
            if (result?.Success == true)
            {
                newChapterName = "";
                showNewChapterInput = false;
                successMessage = "Chapter added.";
                var chapterRes = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<ChapterDto>>>(
                    $"/api/v1/testbanks/{BankId}/chapters");
                chapters = chapterRes?.Data?.ToList() ?? new();
                if (result.Data is not null) await SelectChapter(result.Data);
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        StateHasChanged();
    }

    private void StartChapterEdit(ChapterDto ch)
    {
        editingChapterId = ch.Id;
        editChapterName = ch.Name;
    }

    private void CancelChapterEdit()
    {
        editingChapterId = null;
        editChapterName = "";
    }

    private async Task SaveChapterRename(int chapterId)
    {
        if (string.IsNullOrWhiteSpace(editChapterName)) return;
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PutAsJsonAsync($"/api/v1/chapters/{chapterId}",
                new ChapterCreateDto { Name = editChapterName });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                editingChapterId = null;
                successMessage = "Chapter renamed.";
                var chapterRes = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<ChapterDto>>>(
                    $"/api/v1/testbanks/{BankId}/chapters");
                chapters = chapterRes?.Data?.ToList() ?? new();
                if (selectedChapter is not null)
                    selectedChapter = chapters.FirstOrDefault(c => c.Id == chapterId) ?? selectedChapter;
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        StateHasChanged();
    }

    private async Task ConfirmDeleteChapter(int chapterId)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.DeleteAsync($"/api/v1/chapters/{chapterId}");
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                deletingChapterId = null;
                successMessage = "Chapter deleted.";
                var chapterRes = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<ChapterDto>>>(
                    $"/api/v1/testbanks/{BankId}/chapters");
                chapters = chapterRes?.Data?.ToList() ?? new();
                selectedChapter = chapters.FirstOrDefault();
                questions = new();
                if (selectedChapter is not null) await SelectChapter(selectedChapter);
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { deletingChapterId = null; StateHasChanged(); }
    }

    private void StartEditQuestion(QuestionDto q)
    {
        editingQuestionId = q.Id;
        qForm = new()
        {
            Content = q.Content,
            Points = q.Points,
            OptionTexts = q.Options.Select(o => o.Text).ToArray(),
            CorrectIndex = q.Options.FindIndex(o => o.IsCorrect)
        };
        showQuestionForm = true;
        errorMessage = null;
        successMessage = null;
    }

    private async Task SaveQuestion()
    {
        if (selectedChapter is null || string.IsNullOrWhiteSpace(qForm.Content)) return;
        errorMessage = null; successMessage = null;

        var options = qForm.OptionTexts
            .Select((text, i) => new OptionCreateDto { Text = text ?? "", IsCorrect = i == qForm.CorrectIndex })
            .ToList();

        var dto = new QuestionCreateDto { Content = qForm.Content, Points = qForm.Points, Options = options };

        try
        {
            var http = await Api.CreateAsync();
            HttpResponseMessage res;

            if (editingQuestionId.HasValue)
                res = await http.PutAsJsonAsync($"/api/v1/questions/{editingQuestionId.Value}", dto);
            else
                res = await http.PostAsJsonAsync($"/api/v1/chapters/{selectedChapter.Id}/questions", dto);

            bool saved;
            string? apiMsg = null;
            if (editingQuestionId.HasValue)
            {
                var r = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
                saved = r?.Success == true; apiMsg = r?.Message;
            }
            else
            {
                var r = await res.Content.ReadFromJsonAsync<ServiceResponse<QuestionDto>>();
                saved = r?.Success == true; apiMsg = r?.Message;
            }

            if (saved)
            {
                var wasEditing = editingQuestionId.HasValue;
                showQuestionForm = false;
                editingQuestionId = null;
                ResetQuestionForm();
                successMessage = wasEditing ? "Question updated." : "Question added.";
                await SelectChapter(selectedChapter);
            }
            else errorMessage = apiMsg ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task ConfirmDeleteQuestion(int questionId)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.DeleteAsync($"/api/v1/questions/{questionId}");
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                deletingQuestionId = null;
                successMessage = "Question deleted.";
                if (selectedChapter is not null) await SelectChapter(selectedChapter);
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { deletingQuestionId = null; StateHasChanged(); }
    }
}
