@page "/instructor"
@attribute [Authorize(Roles = "INSTRUCTOR,CHAIR,ADMIN")]
@inject LanguageService Lang
@inject ApiClient Api
@implements IDisposable
@rendermode InteractiveServer

<PageTitle>@Lang.T("instructor.title")</PageTitle>

<div class="max-w-5xl mx-auto px-4 py-8">

    <div class="mb-8">
        <h1 class="text-3xl font-bold text-primary">@Lang.T("instructor.title")</h1>
        <p class="text-secondary mt-1">@Lang.T("instructor.subtitle")</p>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">@Lang.T("common.loading.courses")</p>
    }
    else if (courses.Count == 0)
    {
        <div class="text-center py-16 text-secondary">
            <p class="text-lg font-medium mb-2">@Lang.T("courses.no.courses")</p>
            <p class="text-sm">@Lang.T("courses.no.courses.hint")</p>
        </div>
    }
    else
    {
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4">
            @foreach (var course in courses)
            {
                <div class="bg-white border border-brand-4 rounded-2xl p-6 shadow-sm hover:shadow-md transition-all">
                    <h2 class="font-semibold text-foreground text-base mb-1">@course.Name</h2>
                    <p class="text-xs text-secondary mb-4">@course.Code</p>
                    <div class="flex items-center gap-2 flex-wrap">
                        <a href="/instructor/@course.Id/banks"
                           class="text-xs px-3 py-1.5 rounded-lg bg-brand-4 text-primary font-medium hover:bg-primary hover:text-white transition-colors">
                            @Lang.T("courses.nav.banks")
                        </a>
                        <a href="/instructor/@course.Id/exams"
                           class="text-xs px-3 py-1.5 rounded-lg bg-brand-4 text-primary font-medium hover:bg-primary hover:text-white transition-colors">
                            @Lang.T("courses.nav.exams")
                        </a>
                        <a href="/instructor/@course.Id/sections"
                           class="text-xs px-3 py-1.5 rounded-lg bg-brand-4 text-primary font-medium hover:bg-primary hover:text-white transition-colors">
                            @Lang.T("courses.nav.sections")
                        </a>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private List<CourseDto> courses = new();
    private bool isLoaded = false;
    private string? errorMessage;

    protected override void OnInitialized() => Lang.OnChange += Refresh;
    private void Refresh() => InvokeAsync(StateHasChanged);
    public void Dispose() => Lang.OnChange -= Refresh;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<CourseDto>>>(
                "/api/v1/courses");
            courses = res?.Data?.ToList() ?? new();
        }
        catch (Exception ex)
        {
            errorMessage = $"Failed to load courses: {ex.Message}";
        }
        finally
        {
            isLoaded = true;
            StateHasChanged();
        }
    }
}
