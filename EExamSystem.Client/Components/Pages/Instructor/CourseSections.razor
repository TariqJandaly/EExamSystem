@page "/instructor/{CourseId:int}/sections"
@attribute [Authorize(Roles = "INSTRUCTOR,CHAIR,ADMIN")]
@inject LanguageService Lang
@inject ApiClient Api
@rendermode InteractiveServer

<PageTitle>@Lang.T("sections.title")</PageTitle>

<div class="max-w-4xl mx-auto px-4 py-8">

    <div class="flex items-center gap-2 text-sm text-secondary mb-6">
        <a href="/instructor" class="hover:text-primary transition-colors">@Lang.T("instructor.title")</a>
        <span>/</span>
        <span class="text-foreground font-medium">Course #@CourseId — @Lang.T("sections.title")</span>
    </div>

    <div class="flex items-start justify-between mb-6">
        <div>
            <h1 class="text-3xl font-bold text-primary">@Lang.T("sections.title")</h1>
            <p class="text-secondary mt-1">@Lang.T("sections.subtitle")</p>
        </div>
        <button @onclick="() => { showCreateForm = !showCreateForm; errorMessage = null; successMessage = null; }"
                class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
            @Lang.T("sections.create")
        </button>
    </div>

    @if (errorMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-red-50 border border-red-200 text-red-700 text-sm">@errorMessage</div>
    }
    @if (successMessage is not null)
    {
        <div class="mb-4 px-4 py-3 rounded-lg bg-green-50 border border-green-200 text-green-700 text-sm">@successMessage</div>
    }

    @if (showCreateForm)
    {
        <div class="bg-white border border-primary rounded-2xl p-6 shadow-sm mb-6">
            <h3 class="font-semibold text-foreground mb-4">@Lang.T("sections.form.new")</h3>
            <div class="flex gap-3">
                <input @bind="newSectionName" placeholder="@Lang.T("sections.name.ph")"
                       class="flex-1 px-4 py-2 rounded-lg border border-brand-4 bg-brand-5 text-foreground text-sm focus:outline-none focus:ring-2 focus:ring-primary" />
                <button @onclick="CreateSection"
                        class="px-4 py-2 rounded-lg bg-primary text-white text-sm font-semibold hover:bg-primary-light transition-colors">
                    @Lang.T("action.create")
                </button>
                <button @onclick="() => showCreateForm = false"
                        class="px-4 py-2 rounded-lg border border-brand-4 text-sm text-secondary hover:bg-brand-5 transition-colors">
                    @Lang.T("action.cancel")
                </button>
            </div>
        </div>
    }

    @if (!isLoaded)
    {
        <p class="text-secondary text-sm">@Lang.T("common.loading.sections")</p>
    }
    else if (sections.Count == 0)
    {
        <div class="text-center py-16 text-secondary border border-dashed border-brand-4 rounded-2xl">
            <p class="font-medium">@Lang.T("sections.empty")</p>
        </div>
    }
    else
    {
        <div class="flex flex-col gap-4">
            @foreach (var sec in sections)
            {
                <div class="bg-white border border-brand-4 rounded-2xl shadow-sm overflow-hidden">
                    <div class="flex items-center justify-between px-6 py-4">
                        <div>
                            <h2 class="font-semibold text-foreground">@sec.Name</h2>
                            <p class="text-xs text-secondary mt-0.5">@string.Format(Lang.T("sections.id"), sec.Id)</p>
                        </div>
                        <div class="flex items-center gap-3">
                            <button @onclick="async () => await ToggleEnrollPanel(sec.Id)"
                                    class="text-xs px-3 py-1.5 rounded-lg border border-brand-4 text-secondary hover:text-primary hover:border-primary transition-colors">
                                @Lang.T("sections.enroll.btn")
                            </button>
                            @if (deletingSectionId == sec.Id)
                            {
                                <span class="text-xs text-red-600 flex items-center gap-1">
                                    @Lang.T("action.confirm")
                                    <button @onclick="() => ConfirmDeleteSection(sec.Id)" class="underline ml-1">@Lang.T("action.yes")</button>
                                    <button @onclick="() => deletingSectionId = null" class="underline ml-1">@Lang.T("action.no")</button>
                                </span>
                            }
                            else
                            {
                                <button @onclick="() => deletingSectionId = sec.Id"
                                        class="text-xs text-red-400 hover:text-red-600 transition-colors">
                                    @Lang.T("action.delete")
                                </button>
                            }
                        </div>
                    </div>

                    @if (enrollPanelSectionId == sec.Id)
                    {
                        <div class="border-t border-brand-5 px-6 py-4 bg-brand-5/40">
                            <p class="text-xs font-medium text-secondary mb-2">@Lang.T("sections.enroll.header")</p>
                            @if (studentsLoading)
                            {
                                <p class="text-xs text-secondary">@Lang.T("common.loading.students")</p>
                            }
                            else if (availableStudents.Count == 0)
                            {
                                <p class="text-xs text-secondary">@Lang.T("sections.no.students")</p>
                            }
                            else
                            {
                                <div class="flex gap-2 flex-wrap">
                                    <select @bind="enrollStudentId"
                                            class="flex-1 px-3 py-1.5 rounded-lg border border-brand-4 bg-white text-sm focus:outline-none focus:ring-2 focus:ring-primary">
                                        <option value="">@Lang.T("sections.select.student")</option>
                                        @foreach (var student in availableStudents)
                                        {
                                            <option value="@student.Id">@student.FullName (@student.Email)</option>
                                        }
                                    </select>
                                    <button @onclick="() => EnrollStudent(sec.Id)"
                                            class="px-3 py-1.5 rounded-lg bg-primary text-white text-sm font-medium hover:bg-primary-light transition-colors">
                                        @Lang.T("sections.enroll.action")
                                    </button>
                                    <button @onclick="CancelEnroll"
                                            class="px-3 py-1.5 rounded-lg border border-brand-4 text-sm text-secondary hover:bg-brand-5 transition-colors">
                                        @Lang.T("action.cancel")
                                    </button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int CourseId { get; set; }

    private List<SectionDto> sections = new();
    private bool isLoaded = false;
    private string? errorMessage;
    private string? successMessage;

    private bool showCreateForm = false;
    private string newSectionName = "";
    private int? deletingSectionId;
    private int? enrollPanelSectionId;
    private string enrollStudentId = "";
    private List<UserDto> availableStudents = new();
    private bool studentsLoading = false;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        await LoadSections();
    }

    private async Task LoadSections()
    {
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<IEnumerable<SectionDto>>>(
                $"/api/v1/sections/course/{CourseId}");
            sections = res?.Data?.ToList() ?? new();
        }
        catch (Exception ex) { errorMessage = $"Failed to load sections: {ex.Message}"; }
        finally { isLoaded = true; StateHasChanged(); }
    }

    private async Task CreateSection()
    {
        if (string.IsNullOrWhiteSpace(newSectionName)) return;
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PostAsJsonAsync("/api/v1/sections",
                new CreateSectionDto { Name = newSectionName, CourseId = CourseId });
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<SectionDto>>();
            if (result?.Success == true)
            {
                newSectionName = "";
                showCreateForm = false;
                successMessage = "Section created.";
                await LoadSections();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }

    private async Task ConfirmDeleteSection(int sectionId)
    {
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.DeleteAsync($"/api/v1/sections/{sectionId}");
            var result = await res.Content.ReadFromJsonAsync<ServiceResponse<bool>>();
            if (result?.Success == true)
            {
                successMessage = "Section deleted.";
                await LoadSections();
            }
            else errorMessage = result?.Message ?? Lang.T("err.save");
        }
        catch (Exception ex) { errorMessage = ex.Message; }
        finally { deletingSectionId = null; StateHasChanged(); }
    }

    private void CancelEnroll()
    {
        enrollPanelSectionId = null;
        enrollStudentId = "";
        availableStudents = new();
    }

    private async Task ToggleEnrollPanel(int sectionId)
    {
        if (enrollPanelSectionId == sectionId) { CancelEnroll(); return; }

        enrollPanelSectionId = sectionId;
        enrollStudentId = "";
        errorMessage = null;
        studentsLoading = true;
        StateHasChanged();

        try
        {
            var http = await Api.CreateAsync();
            var res = await http.GetFromJsonAsync<ServiceResponse<List<UserDto>>>("/api/v1/user");
            availableStudents = res?.Data?
                .Where(u => u.Roles.Contains("STUDENT"))
                .ToList() ?? new();
        }
        catch { availableStudents = new(); }
        finally { studentsLoading = false; StateHasChanged(); }
    }

    private async Task EnrollStudent(int sectionId)
    {
        if (string.IsNullOrWhiteSpace(enrollStudentId)) return;
        errorMessage = null; successMessage = null;
        try
        {
            var http = await Api.CreateAsync();
            var res = await http.PostAsync(
                $"/api/v1/enrollment/sections/{sectionId}/students/{enrollStudentId.Trim()}",
                null);

            var text = await res.Content.ReadAsStringAsync();

            if (res.IsSuccessStatusCode)
            {
                enrollStudentId = "";
                enrollPanelSectionId = null;
                availableStudents = new();
                successMessage = "Student enrolled successfully.";
                StateHasChanged();
            }
            else
            {
                // Try to parse JSON error, fall back to raw text
                try
                {
                    var result = System.Text.Json.JsonSerializer.Deserialize<ServiceResponse<bool>>(
                        text, new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true });
                    errorMessage = result?.Message ?? text;
                }
                catch { errorMessage = text; }
            }
        }
        catch (Exception ex) { errorMessage = ex.Message; }
    }
}
